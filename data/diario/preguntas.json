[
  { "id": "dia-0001", "tema": "musica", "intensidad": 1, "tipo": "opciones", "adivinar": true, "texto": "Si solo pudieras oír un género por el resto de tu vida, ¿cuál escoges?", "opciones": [{ "texto": "Salsa" }, { "texto": "Rap" }, { "texto": "Reguetón" }, { "texto": "Rock" }] },
  { "id": "dia-0002", "tema": "musica", "intensidad": 1, "tipo": "escala", "adivinar": true, "texto": "¿Qué tanto te importa que tu pareja tenga buen gusto musical?", "extremos": ["Me da igual", "Es clave"] },
  { "id": "dia-0003", "tema": "musica", "intensidad": 1, "tipo": "opciones", "adivinar": true, "texto": "En un viaje largo en carro, ¿quién pone la música?", "opciones": [{ "texto": "Yo, siempre", "rasgos": { "independencia": 1 } }, { "texto": "Tú, siempre" }, { "texto": "Turnos de a una canción", "rasgos": { "independencia": -1 } }, { "texto": "Radio y ya" }] },
  { "id": "dia-0004", "tema": "musica", "intensidad": 1, "tipo": "opciones", "adivinar": true, "texto": "¿Qué te daría más pena que descubrieran en tu historial de música?", "opciones": [{ "texto": "Despecho a todo volumen" }, { "texto": "Canciones de novela o infantiles" }, { "texto": "Reguetón de 2010" }, { "texto": "Nada, oigo todo con orgullo" }] },
  { "id": "dia-0005", "tema": "musica", "intensidad": 1, "tipo": "opciones", "texto": "¿A qué concierto irías aunque te tocara gastarte la plata de todo el mes?", "opciones": [{ "texto": "El de mi artista favorito, en primera fila", "rasgos": { "ahorro": -1 } }, { "texto": "Un festival de tres días fuera del país", "rasgos": { "ahorro": -2, "aventura": 1 } }, { "texto": "Uno pequeño e íntimo de alguien que casi nadie conoce" }, { "texto": "Ninguno vale tanto", "rasgos": { "ahorro": 2 } }] },
  { "id": "dia-0006", "tema": "musica", "intensidad": 1, "tipo": "escala", "texto": "Cuando estás mal, ¿qué tanto te hunde una canción triste?", "extremos": ["Nada, es solo música", "Me destruye"] },
  { "id": "dia-0007", "tema": "musica", "intensidad": 2, "tipo": "opciones", "adivinar": true, "texto": "Una canción que te recuerda a un ex: ¿sigue siendo tuya o queda dañada?", "opciones": [{ "texto": "Sigue siendo mía" }, { "texto": "Queda dañada para siempre" }, { "texto": "Depende de cómo terminó" }, { "texto": "Se vuelve nuestra si la oímos juntos" }] },
  { "id": "dia-0008", "tema": "musica", "intensidad": 1, "tipo": "opciones", "adivinar": true, "texto": "Si nuestra relación fuera un género musical, ¿cuál sería?", "opciones": [{ "texto": "Bolero" }, { "texto": "Reguetón" }, { "texto": "Rap" }, { "texto": "Salsa" }] },
  { "id": "dia-0009", "tema": "musica", "intensidad": 1, "tipo": "opciones", "adivinar": true, "texto": "¿Cantar en un karaoke delante de desconocidos?", "opciones": [{ "texto": "Feliz, paso de primero", "rasgos": { "social": 2 } }, { "texto": "Solo con unos tragos encima", "rasgos": { "social": 1 } }, { "texto": "Solo si cantamos juntos" }, { "texto": "Jamás en la vida", "rasgos": { "social": -1 } }] },
  { "id": "dia-0010", "tema": "musica", "intensidad": 1, "tipo": "opciones", "texto": "Las letras que más te pegan son las que hablan de…", "opciones": [{ "texto": "Amor y desamor" }, { "texto": "La calle y la realidad del país" }, { "texto": "Fiesta y gozadera" }, { "texto": "La vida, el tiempo y el sentido de todo" }] },
  { "id": "dia-0011", "tema": "musica", "intensidad": 1, "tipo": "escala", "adivinar": true, "texto": "¿Qué tanto aguantarías que tu pareja ponga a todo volumen una música que odias?", "extremos": ["Cero, la apago", "Lo que sea por verla feliz"], "rasgo": { "id": "independencia", "signo": -1 } },
  { "id": "dia-0012", "tema": "musica", "intensidad": 1, "tipo": "opciones", "adivinar": true, "texto": "Para un primer baile en nuestra boda, ¿qué pondrías?", "opciones": [{ "texto": "Una balada clásica", "rasgos": { "tradicion": 1 } }, { "texto": "Una salsa para lucirnos" }, { "texto": "Algo que nadie se espere", "rasgos": { "tradicion": -1 } }, { "texto": "Nada de primer baile", "rasgos": { "tradicion": -2 } }] },

  { "id": "dia-0013", "tema": "futuro_solo", "intensidad": 2, "tipo": "opciones", "adivinar": true, "texto": "Te ofrecen el trabajo de tus sueños en otro país y tienes que irte en un mes. ¿Qué haces?", "opciones": [{ "texto": "Me voy y vemos cómo hacemos", "rasgos": { "independencia": 2, "aventura": 1 } }, { "texto": "Lo rechazo", "rasgos": { "independencia": -1 } }, { "texto": "Negocio irme en un año", "rasgos": { "planificacion": 1 } }, { "texto": "Solo si te vienes conmigo", "rasgos": { "independencia": -2 } }] },
  { "id": "dia-0014", "tema": "futuro_solo", "intensidad": 1, "tipo": "escala", "adivinar": true, "texto": "¿Qué tan importante es para ti ganar mucha plata en la vida?", "extremos": ["Con vivir bien me basta", "Muchísimo"] },
  { "id": "dia-0015", "tema": "futuro_solo", "intensidad": 1, "tipo": "opciones", "adivinar": true, "texto": "A los 40 te ves…", "opciones": [{ "texto": "Con negocio propio" }, { "texto": "Con un buen cargo en una empresa grande", "rasgos": { "aventura": -1 } }, { "texto": "Viviendo tranquilo en el campo", "rasgos": { "ciudad": -2 } }, { "texto": "Trabajando remoto y viajando", "rasgos": { "aventura": 2 } }] },
  { "id": "dia-0016", "tema": "futuro_solo", "intensidad": 1, "tipo": "opciones", "texto": "¿Volverías a estudiar una carrera completamente distinta?", "opciones": [{ "texto": "Sí, ya mismo", "rasgos": { "tradicion": -1, "aventura": 1 } }, { "texto": "Sí, cuando tenga la plata", "rasgos": { "planificacion": 1 } }, { "texto": "Una especialización, no otra carrera" }, { "texto": "No, estoy donde quiero estar", "rasgos": { "aventura": -1 } }] },
  { "id": "dia-0017", "tema": "futuro_solo", "intensidad": 2, "tipo": "escala", "adivinar": true, "texto": "¿Qué tanto miedo te da fracasar en lo que más quieres?", "extremos": ["Ninguno", "Me paraliza"] },
  { "id": "dia-0018", "tema": "futuro_solo", "intensidad": 1, "tipo": "opciones", "adivinar": true, "texto": "Te ganas 500 millones. ¿Qué es lo primero que haces?", "opciones": [{ "texto": "Compro casa", "rasgos": { "ahorro": 1, "tradicion": 1 } }, { "texto": "Los invierto todos", "rasgos": { "ahorro": 2 } }, { "texto": "Renuncio y me voy un año a viajar", "rasgos": { "ahorro": -2, "aventura": 2 } }, { "texto": "Ayudo a mi familia" }] },
  { "id": "dia-0019", "tema": "futuro_solo", "intensidad": 2, "tipo": "opciones", "texto": "¿Qué te gustaría que dijeran de ti cuando tengas 80?", "opciones": [{ "texto": "Que fui buena persona" }, { "texto": "Que logré cosas grandes" }, { "texto": "Que lo disfruté todo", "rasgos": { "ahorro": -1 } }, { "texto": "Que amé y me amaron" }] },
  { "id": "dia-0020", "tema": "futuro_solo", "intensidad": 1, "tipo": "opciones", "adivinar": true, "texto": "¿Trabajarías en algo que no te gusta si te pagan el triple?", "opciones": [{ "texto": "Sí, sin pensarlo", "rasgos": { "ahorro": 1 } }, { "texto": "Sí, pero solo unos años", "rasgos": { "planificacion": 1 } }, { "texto": "No, la plata no lo es todo", "rasgos": { "ahorro": -1 } }, { "texto": "Depende de qué tan feo sea" }] },
  { "id": "dia-0021", "tema": "futuro_solo", "intensidad": 1, "tipo": "escala", "adivinar": true, "texto": "¿Cuánto tiempo a solas necesitas cada semana para estar bien?", "extremos": ["Ninguno, me gusta estar acompañado", "Muchísimo"], "rasgo": { "id": "independencia", "signo": 1 } },
  { "id": "dia-0022", "tema": "futuro_solo", "intensidad": 1, "tipo": "opciones", "texto": "Si pudieras aprender algo de un día para otro, sería…", "opciones": [{ "texto": "Un idioma nuevo" }, { "texto": "Tocar un instrumento" }, { "texto": "Cocinar como chef" }, { "texto": "Invertir y manejar la plata", "rasgos": { "ahorro": 1 } }] },
  { "id": "dia-0023", "tema": "futuro_solo", "intensidad": 1, "tipo": "opciones", "adivinar": true, "texto": "Te dan un año sabático pagado. ¿Qué haces?", "opciones": [{ "texto": "Viajar por el mundo", "rasgos": { "aventura": 2 } }, { "texto": "Estudiar algo nuevo" }, { "texto": "Montar un negocio" }, { "texto": "Descansar en casa sin culpa", "rasgos": { "social": -1, "aventura": -1 } }] },
  { "id": "dia-0024", "tema": "futuro_solo", "intensidad": 1, "tipo": "opciones", "adivinar": true, "texto": "¿Te gustaría ser famoso?", "opciones": [{ "texto": "Sí, me encantaría", "rasgos": { "social": 1 } }, { "texto": "Solo en lo mío" }, { "texto": "Para nada", "rasgos": { "social": -1 } }, { "texto": "Famoso no, rico sí" }] },

  { "id": "dia-0025", "tema": "futuro_pareja", "intensidad": 1, "tipo": "opciones", "adivinar": true, "texto": "¿Dónde nos ves viviendo en cinco años?", "opciones": [{ "texto": "En esta ciudad", "rasgos": { "aventura": -1 } }, { "texto": "En otra ciudad de Colombia" }, { "texto": "En otro país", "rasgos": { "aventura": 2 } }, { "texto": "En una finca o un pueblo", "rasgos": { "ciudad": -2 } }] },
  { "id": "dia-0026", "tema": "futuro_pareja", "intensidad": 2, "tipo": "opciones", "adivinar": true, "texto": "¿Cuántos hijos te imaginas?", "opciones": [{ "texto": "Ninguno", "rasgos": { "hijos": -2 } }, { "texto": "Uno", "rasgos": { "hijos": 1 } }, { "texto": "Dos", "rasgos": { "hijos": 2 } }, { "texto": "Tres o más", "rasgos": { "hijos": 2, "tradicion": 1 } }] },
  { "id": "dia-0027", "tema": "futuro_pareja", "intensidad": 2, "tipo": "opciones", "adivinar": true, "texto": "Viviendo juntos, ¿la plata cómo?", "opciones": [{ "texto": "Todo junto", "rasgos": { "independencia": -2 } }, { "texto": "Todo separado", "rasgos": { "independencia": 2 } }, { "texto": "Una cuenta común para lo de la casa", "rasgos": { "planificacion": 1 } }, { "texto": "Lo que salga, sin reglas", "rasgos": { "planificacion": -2 } }] },
  { "id": "dia-0028", "tema": "futuro_pareja", "intensidad": 2, "tipo": "opciones", "adivinar": true, "texto": "¿Boda grande o pequeña?", "opciones": [{ "texto": "Grande, con toda la familia", "rasgos": { "tradicion": 2, "social": 1 } }, { "texto": "Pequeña, solo los más cercanos" }, { "texto": "Nos fugamos a una notaría", "rasgos": { "tradicion": -1 } }, { "texto": "No quiero casarme", "rasgos": { "tradicion": -2 } }] },
  { "id": "dia-0029", "tema": "futuro_pareja", "intensidad": 2, "tipo": "escala", "adivinar": true, "texto": "¿Qué tan cerca de tu familia te gustaría que viviéramos?", "extremos": ["Lejos, muy lejos", "En la misma cuadra"], "rasgo": { "id": "tradicion", "signo": 1 } },
  { "id": "dia-0030", "tema": "futuro_pareja", "intensidad": 1, "tipo": "opciones", "adivinar": true, "texto": "¿Una mascota juntos?", "opciones": [{ "texto": "Un perro, ya" }, { "texto": "Un gato, ya" }, { "texto": "Cuando tengamos casa propia", "rasgos": { "planificacion": 1 } }, { "texto": "Mejor sin mascotas" }] },
  { "id": "dia-0031", "tema": "futuro_pareja", "intensidad": 1, "tipo": "opciones", "adivinar": true, "texto": "Para nuestro primer viaje grande, ¿a dónde?", "opciones": [{ "texto": "Europa" }, { "texto": "Una playa del Caribe", "rasgos": { "aventura": -1 } }, { "texto": "Recorrer Suramérica de mochileros", "rasgos": { "aventura": 2, "ahorro": 1 } }, { "texto": "Asia", "rasgos": { "aventura": 1 } }] },
  { "id": "dia-0032", "tema": "futuro_pareja", "intensidad": 2, "tipo": "opciones", "adivinar": true, "texto": "Si tenemos hijos, ¿quién va a ser más estricto?", "opciones": [{ "texto": "Yo" }, { "texto": "Tú" }, { "texto": "Los dos por igual" }, { "texto": "Ninguno, vamos a ser alcahuetas" }] },
  { "id": "dia-0033", "tema": "futuro_pareja", "intensidad": 2, "tipo": "opciones", "adivinar": true, "texto": "¿Vivir juntos antes de casarse?", "opciones": [{ "texto": "Obvio, es necesario", "rasgos": { "tradicion": -1 } }, { "texto": "Sí, pero poco tiempo" }, { "texto": "Mejor no", "rasgos": { "tradicion": 2 } }, { "texto": "No pienso casarme, así que da igual", "rasgos": { "tradicion": -2 } }] },
  { "id": "dia-0034", "tema": "futuro_pareja", "intensidad": 1, "tipo": "escala", "adivinar": true, "texto": "¿Qué tanto planeas nuestro futuro en tu cabeza?", "extremos": ["Nada, vivo el día", "Tengo todo el plan"], "rasgo": { "id": "planificacion", "signo": 1 } },
  { "id": "dia-0035", "tema": "futuro_pareja", "intensidad": 1, "tipo": "opciones", "texto": "Si mañana no tuviéramos que volver a trabajar, ¿cómo serían nuestros días?", "opciones": [{ "texto": "Viajando todo el tiempo", "rasgos": { "aventura": 2 } }, { "texto": "En una casa con jardín, tranquilos", "rasgos": { "ciudad": -1, "aventura": -1 } }, { "texto": "Montando un proyecto juntos", "rasgos": { "independencia": -1 } }, { "texto": "Cada uno en lo suyo y juntos de noche", "rasgos": { "independencia": 2 } }] },
  { "id": "dia-0036", "tema": "futuro_pareja", "intensidad": 2, "tipo": "opciones", "adivinar": true, "texto": "¿Compartir la ubicación del celular todo el tiempo?", "opciones": [{ "texto": "Sí, siempre activada", "rasgos": { "celos": 1 } }, { "texto": "Solo cuando uno viaja o sale tarde" }, { "texto": "No, me parece control", "rasgos": { "celos": -1, "independencia": 1 } }, { "texto": "Me da igual", "rasgos": { "celos": -1 } }] },

  { "id": "dia-0037", "tema": "dilema", "intensidad": 2, "tipo": "opciones", "adivinar": true, "texto": "Encuentras una billetera con dos millones y la cédula del dueño. Nadie te vio. ¿Qué haces?", "opciones": [{ "texto": "La devuelvo completa" }, { "texto": "La devuelvo y me quedo con algo" }, { "texto": "Devuelvo los papeles y me quedo la plata" }, { "texto": "La dejo donde estaba" }] },
  { "id": "dia-0038", "tema": "dilema", "intensidad": 3, "tipo": "opciones", "adivinar": true, "texto": "Tu mejor amigo te cuenta un secreto que me afecta y te pide no decírmelo. ¿Qué haces?", "opciones": [{ "texto": "Te lo cuento igual", "rasgos": { "independencia": -1 } }, { "texto": "Le guardo el secreto" }, { "texto": "Le exijo que te lo cuente él" }, { "texto": "Depende de qué tan grave sea" }] },
  { "id": "dia-0039", "tema": "dilema", "intensidad": 2, "tipo": "opciones", "adivinar": true, "texto": "Puedes leer lo que piensa tu pareja durante un día entero. ¿Aceptas?", "opciones": [{ "texto": "Sí, de una", "rasgos": { "celos": 2 } }, { "texto": "No, prefiero no saber", "rasgos": { "celos": -1 } }, { "texto": "Solo si tú también puedes leerme" }, { "texto": "Solo una hora" }] },
  { "id": "dia-0040", "tema": "dilema", "intensidad": 2, "tipo": "opciones", "adivinar": true, "texto": "Te ofrecen 100 millones por no hablarme durante un año. ¿Aceptas?", "opciones": [{ "texto": "Sí, y nos los repartimos", "rasgos": { "ahorro": 1 } }, { "texto": "No, por ninguna plata", "rasgos": { "independencia": -1 } }, { "texto": "Solo si me prometes esperarme" }, { "texto": "Lo pensaría mucho" }] },
  { "id": "dia-0041", "tema": "dilema", "intensidad": 1, "tipo": "opciones", "adivinar": true, "texto": "¿Viaje gratis a donde quieras, pero solo, o un viaje sencillo juntos?", "opciones": [{ "texto": "El gratis, solo", "rasgos": { "independencia": 2 } }, { "texto": "El sencillo, juntos", "rasgos": { "independencia": -2 } }, { "texto": "El gratis y te traigo regalos", "rasgos": { "independencia": 1 } }, { "texto": "Ninguno, me quedo en casa", "rasgos": { "aventura": -2 } }] },
  { "id": "dia-0042", "tema": "dilema", "intensidad": 3, "tipo": "opciones", "adivinar": true, "texto": "Un ex te escribe años después para pedirte perdón. ¿Qué haces?", "opciones": [{ "texto": "Le respondo con amabilidad", "rasgos": { "celos": -1 } }, { "texto": "Lo dejo en visto" }, { "texto": "Te muestro el mensaje y decidimos" }, { "texto": "Lo bloqueo", "rasgos": { "celos": 1 } }] },
  { "id": "dia-0043", "tema": "dilema", "intensidad": 1, "tipo": "opciones", "adivinar": true, "texto": "Puedes volver a vivir un año de tu vida. ¿Cuál escoges?", "opciones": [{ "texto": "Uno de la infancia" }, { "texto": "Uno del colegio" }, { "texto": "Uno de la universidad" }, { "texto": "Uno de los que llevamos juntos" }] },
  { "id": "dia-0044", "tema": "dilema", "intensidad": 1, "tipo": "opciones", "adivinar": true, "texto": "¿Qué poder escogerías?", "opciones": [{ "texto": "Volar", "rasgos": { "aventura": 1 } }, { "texto": "Ser invisible" }, { "texto": "Teletransportarme" }, { "texto": "Leer mentes", "rasgos": { "celos": 1 } }] },
  { "id": "dia-0045", "tema": "dilema", "intensidad": 3, "tipo": "opciones", "adivinar": true, "texto": "Descubres que un amigo en común le está poniendo los cachos a su pareja. ¿Qué haces?", "opciones": [{ "texto": "Se lo cuento a la pareja" }, { "texto": "Hablo con el amigo primero" }, { "texto": "No me meto" }, { "texto": "Te lo cuento y decidimos juntos", "rasgos": { "independencia": -1 } }] },
  { "id": "dia-0046", "tema": "dilema", "intensidad": 1, "tipo": "opciones", "texto": "¿Dejarías tus redes sociales para siempre por 50 millones?", "opciones": [{ "texto": "Sí, ya mismo" }, { "texto": "No, las necesito", "rasgos": { "social": 1 } }, { "texto": "Sí, y me abro otra cuenta escondida" }, { "texto": "Por 50 no, por 200 sí", "rasgos": { "ahorro": 1 } }] },
  { "id": "dia-0047", "tema": "dilema", "intensidad": 2, "tipo": "opciones", "adivinar": true, "texto": "¿Una vida tranquila y predecible o una llena de altibajos pero emocionante?", "opciones": [{ "texto": "Tranquila y predecible", "rasgos": { "aventura": -2 } }, { "texto": "Emocionante, con altibajos", "rasgos": { "aventura": 2 } }, { "texto": "Tranquila, con una locura al año" }, { "texto": "Depende de la etapa de la vida" }] },
  { "id": "dia-0048", "tema": "dilema", "intensidad": 2, "tipo": "opciones", "adivinar": true, "texto": "Si pudieras borrar un recuerdo para siempre, ¿lo harías?", "opciones": [{ "texto": "Sí, y sé cuál" }, { "texto": "No, todo me formó" }, { "texto": "Solo si no cambia quién soy" }, { "texto": "Borraría varios" }] },

  { "id": "dia-0049", "tema": "postura", "intensidad": 2, "tipo": "escala", "adivinar": true, "texto": "¿Qué tan de acuerdo estás con que una pareja se revise el celular?", "extremos": ["Nunca está bien", "Es normal"], "rasgo": { "id": "celos", "signo": 1 } },
  { "id": "dia-0050", "tema": "postura", "intensidad": 2, "tipo": "opciones", "adivinar": true, "texto": "¿Está bien seguir siendo amigo de un ex?", "opciones": [{ "texto": "Sí, sin problema", "rasgos": { "celos": -2 } }, { "texto": "Solo si no quedó nada pendiente", "rasgos": { "celos": -1 } }, { "texto": "No, para nada", "rasgos": { "celos": 2 } }, { "texto": "Depende de qué piense la pareja actual" }] },
  { "id": "dia-0051", "tema": "postura", "intensidad": 2, "tipo": "opciones", "adivinar": true, "texto": "En una cita, ¿quién debería pagar?", "opciones": [{ "texto": "Quien invita" }, { "texto": "Mitad y mitad", "rasgos": { "tradicion": -1 } }, { "texto": "El hombre, siempre", "rasgos": { "tradicion": 2 } }, { "texto": "Quien tenga más plata" }] },
  { "id": "dia-0052", "tema": "postura", "intensidad": 1, "tipo": "escala", "adivinar": true, "texto": "¿Qué tanto crees en que «todo pasa por algo»?", "extremos": ["Nada, es azar", "Totalmente"] },
  { "id": "dia-0053", "tema": "postura", "intensidad": 3, "tipo": "opciones", "adivinar": true, "texto": "¿La infidelidad emocional, sin nada físico, es igual de grave?", "opciones": [{ "texto": "Igual o peor", "rasgos": { "celos": 1 } }, { "texto": "Menos grave" }, { "texto": "Eso no es infidelidad", "rasgos": { "celos": -2 } }, { "texto": "Depende de cuánto dure" }] },
  { "id": "dia-0054", "tema": "postura", "intensidad": 2, "tipo": "opciones", "adivinar": true, "texto": "Darle like a fotos de otras personas en redes, ¿es para preocuparse?", "opciones": [{ "texto": "Para nada", "rasgos": { "celos": -2 } }, { "texto": "Depende de la foto" }, { "texto": "Sí, es falta de respeto", "rasgos": { "celos": 2 } }, { "texto": "Solo si es alguien que conocemos", "rasgos": { "celos": 1 } }] },
  { "id": "dia-0055", "tema": "postura", "intensidad": 1, "tipo": "opciones", "adivinar": true, "texto": "Las tareas de la casa se dividen…", "opciones": [{ "texto": "Mitad y mitad exacto", "rasgos": { "planificacion": 1 } }, { "texto": "Según quién tenga más tiempo" }, { "texto": "Cada uno lo que hace mejor" }, { "texto": "Pagamos a alguien y listo", "rasgos": { "ahorro": -1 } }] },
  { "id": "dia-0056", "tema": "postura", "intensidad": 2, "tipo": "escala", "adivinar": true, "texto": "¿Qué tan importante es que tu pareja comparta tu religión o tu forma de ver lo espiritual?", "extremos": ["Nada", "Indispensable"], "rasgo": { "id": "tradicion", "signo": 1 } },
  { "id": "dia-0057", "tema": "postura", "intensidad": 2, "tipo": "opciones", "adivinar": true, "texto": "En una relación, ¿qué pesa más?", "opciones": [{ "texto": "El amor, siempre" }, { "texto": "La estabilidad económica", "rasgos": { "ahorro": 1 } }, { "texto": "Los dos por igual" }, { "texto": "Sin plata, el amor se acaba", "rasgos": { "ahorro": 1 } }] },
  { "id": "dia-0058", "tema": "postura", "intensidad": 3, "tipo": "opciones", "adivinar": true, "texto": "¿Se puede perdonar una infidelidad?", "opciones": [{ "texto": "Sí, depende del caso", "rasgos": { "celos": -1 } }, { "texto": "Nunca", "rasgos": { "celos": 1 } }, { "texto": "Solo si se confiesa" }, { "texto": "Se perdona, pero no se olvida" }] },
  { "id": "dia-0059", "tema": "postura", "intensidad": 3, "tipo": "opciones", "adivinar": true, "texto": "¿Qué piensas de las relaciones abiertas?", "opciones": [{ "texto": "Pueden funcionar para algunos", "rasgos": { "tradicion": -1 } }, { "texto": "No son para mí" }, { "texto": "Son un engaño disfrazado", "rasgos": { "tradicion": 1, "celos": 1 } }, { "texto": "Me dan curiosidad", "rasgos": { "tradicion": -2 } }] },
  { "id": "dia-0060", "tema": "postura", "intensidad": 1, "tipo": "opciones", "adivinar": true, "texto": "¿Una pelea se arregla el mismo día o se deja enfriar?", "opciones": [{ "texto": "El mismo día, nada de dormir bravos" }, { "texto": "Mejor dejarla enfriar" }, { "texto": "Depende de la pelea" }, { "texto": "Que pase sola, sin hablarla" }] },

  { "id": "dia-0061", "tema": "vida_diaria", "intensidad": 1, "tipo": "opciones", "adivinar": true, "texto": "Tu domingo perfecto:", "opciones": [{ "texto": "Desayuno largo y cama", "rasgos": { "social": -1 } }, { "texto": "Paseo de olla o finca", "rasgos": { "ciudad": -1, "social": 1 } }, { "texto": "Rumba el sábado y guayabo el domingo", "rasgos": { "social": 2 } }, { "texto": "Cine, centro comercial y comida", "rasgos": { "ciudad": 1 } }] },
  { "id": "dia-0062", "tema": "vida_diaria", "intensidad": 1, "tipo": "escala", "adivinar": true, "texto": "Siendo honestos, ¿qué tan ordenado eres?", "extremos": ["Desastre total", "Obsesivo"], "rasgo": { "id": "planificacion", "signo": 1 } },
  { "id": "dia-0063", "tema": "vida_diaria", "intensidad": 1, "tipo": "opciones", "adivinar": true, "texto": "¿Bañarse de mañana o de noche?", "opciones": [{ "texto": "De mañana" }, { "texto": "De noche" }, { "texto": "Las dos" }, { "texto": "Cuando toque" }] },
  { "id": "dia-0064", "tema": "vida_diaria", "intensidad": 1, "tipo": "opciones", "adivinar": true, "texto": "¿Qué es lo que más te estresa de un día normal?", "opciones": [{ "texto": "El trancón" }, { "texto": "El trabajo o la U" }, { "texto": "La plata" }, { "texto": "La gente", "rasgos": { "social": -1 } }] },
  { "id": "dia-0065", "tema": "vida_diaria", "intensidad": 1, "tipo": "opciones", "adivinar": true, "texto": "Llegamos muertos del hambre y no hay nada. ¿Qué hacemos?", "opciones": [{ "texto": "Pedimos domicilio", "rasgos": { "ahorro": -1 } }, { "texto": "Cocino con lo que haya", "rasgos": { "ahorro": 1 } }, { "texto": "Salimos a comer", "rasgos": { "ahorro": -1 } }, { "texto": "Huevo con arepa y listo", "rasgos": { "ahorro": 1 } }] },
  { "id": "dia-0066", "tema": "vida_diaria", "intensidad": 1, "tipo": "escala", "adivinar": true, "texto": "¿Qué tanto te cuesta madrugar?", "extremos": ["Nada, me encanta", "Es una tortura"] },
  { "id": "dia-0067", "tema": "vida_diaria", "intensidad": 1, "tipo": "opciones", "adivinar": true, "texto": "¿Cuál es tu peor manía?", "opciones": [{ "texto": "Dejar todo para última hora", "rasgos": { "planificacion": -2 } }, { "texto": "Estar pegado al celular" }, { "texto": "Llegar tarde", "rasgos": { "planificacion": -1 } }, { "texto": "Ser desordenado", "rasgos": { "planificacion": -1 } }] },
  { "id": "dia-0068", "tema": "vida_diaria", "intensidad": 1, "tipo": "opciones", "adivinar": true, "texto": "Te queda una tarde libre sin avisarle a nadie. ¿Qué haces?", "opciones": [{ "texto": "Dormir" }, { "texto": "Llamar a alguien para salir", "rasgos": { "social": 2 } }, { "texto": "Algo productivo", "rasgos": { "planificacion": 1 } }, { "texto": "Series y comida", "rasgos": { "social": -1 } }] },
  { "id": "dia-0069", "tema": "vida_diaria", "intensidad": 1, "tipo": "opciones", "adivinar": true, "texto": "¿Cuánto aguantas sin mirar el celular?", "opciones": [{ "texto": "Menos de 10 minutos" }, { "texto": "Una hora" }, { "texto": "Medio día" }, { "texto": "Un día entero sin problema" }] },
  { "id": "dia-0070", "tema": "vida_diaria", "intensidad": 1, "tipo": "opciones", "adivinar": true, "texto": "Te llega una plata de sorpresa. ¿Qué haces?", "opciones": [{ "texto": "La ahorro toda", "rasgos": { "ahorro": 2 } }, { "texto": "Me doy un gusto con todo", "rasgos": { "ahorro": -2 } }, { "texto": "Mitad y mitad" }, { "texto": "Invito a alguien", "rasgos": { "ahorro": -1, "social": 1 } }] },
  { "id": "dia-0071", "tema": "vida_diaria", "intensidad": 1, "tipo": "opciones", "adivinar": true, "texto": "Cuando discutimos qué ver en Netflix, ¿quién gana?", "opciones": [{ "texto": "Yo" }, { "texto": "Tú" }, { "texto": "El que se canse menos" }, { "texto": "Nadie, terminamos sin ver nada" }] },
  { "id": "dia-0072", "tema": "vida_diaria", "intensidad": 1, "tipo": "escala", "adivinar": true, "texto": "¿Qué tanto te gusta tener planes con otra gente el fin de semana?", "extremos": ["Prefiero quedarme en casa", "Todos los fines"], "rasgo": { "id": "social", "signo": 1 } },

  { "id": "dia-0073", "tema": "recuerdos", "intensidad": 1, "tipo": "opciones", "adivinar": true, "texto": "¿Qué fue lo primero que te gustó de mí?", "opciones": [{ "texto": "Cómo me veía" }, { "texto": "Cómo hablaba" }, { "texto": "Cómo te hacía reír" }, { "texto": "Algo que hice por ti" }] },
  { "id": "dia-0074", "tema": "recuerdos", "intensidad": 1, "tipo": "escala", "adivinar": true, "texto": "¿Qué tan nervioso estabas en nuestra primera cita?", "extremos": ["Tranquilísimo", "Temblando"] },
  { "id": "dia-0075", "tema": "recuerdos", "intensidad": 1, "tipo": "opciones", "adivinar": true, "texto": "¿Cuál ha sido nuestro mejor momento hasta ahora?", "opciones": [{ "texto": "Un viaje", "rasgos": { "aventura": 1 } }, { "texto": "Una noche cualquiera en casa", "rasgos": { "social": -1 } }, { "texto": "Un momento difícil que superamos" }, { "texto": "Una fiesta o una celebración", "rasgos": { "social": 1 } }] },
  { "id": "dia-0076", "tema": "recuerdos", "intensidad": 1, "tipo": "opciones", "adivinar": true, "texto": "¿Quién dijo «te amo» primero?", "opciones": [{ "texto": "Yo" }, { "texto": "Tú" }, { "texto": "Al tiempo" }, { "texto": "No me acuerdo y me da pena" }] },
  { "id": "dia-0077", "tema": "recuerdos", "intensidad": 2, "tipo": "opciones", "adivinar": true, "texto": "Nuestra peor pelea fue por…", "opciones": [{ "texto": "Celos" }, { "texto": "Plata" }, { "texto": "El tiempo juntos" }, { "texto": "Una bobada que ya ni recuerdo" }] },
  { "id": "dia-0078", "tema": "recuerdos", "intensidad": 2, "tipo": "escala", "adivinar": true, "texto": "¿Qué tanto ha cambiado tu vida desde que estamos juntos?", "extremos": ["Casi nada", "Por completo"] },
  { "id": "dia-0079", "tema": "recuerdos", "intensidad": 2, "tipo": "opciones", "adivinar": true, "texto": "¿Cuándo supiste que esto iba en serio?", "opciones": [{ "texto": "En las primeras semanas" }, { "texto": "Cuando conocí a tu familia" }, { "texto": "Después de una pelea fuerte" }, { "texto": "Lo sigo descubriendo" }] },
  { "id": "dia-0080", "tema": "recuerdos", "intensidad": 1, "tipo": "opciones", "adivinar": true, "texto": "Si me regalaras algo que me recuerde a nosotros, sería…", "opciones": [{ "texto": "Una foto enmarcada" }, { "texto": "Una canción" }, { "texto": "Un viaje al sitio donde empezamos" }, { "texto": "Una carta escrita a mano" }] },
  { "id": "dia-0081", "tema": "recuerdos", "intensidad": 2, "tipo": "opciones", "adivinar": true, "texto": "¿Qué es lo que más extrañas de cuando empezamos?", "opciones": [{ "texto": "Los nervios" }, { "texto": "Hablar hasta la madrugada" }, { "texto": "Los detalles" }, { "texto": "Nada, ahora estamos mejor" }] },
  { "id": "dia-0082", "tema": "recuerdos", "intensidad": 1, "tipo": "escala", "adivinar": true, "texto": "¿Qué tan bien crees que me conoces?", "extremos": ["Casi nada", "Mejor que nadie"] },
  { "id": "dia-0083", "tema": "recuerdos", "intensidad": 1, "tipo": "opciones", "adivinar": true, "texto": "¿Qué cosa mía se te pegó?", "opciones": [{ "texto": "Una palabra o una forma de hablar" }, { "texto": "Una comida" }, { "texto": "Una música" }, { "texto": "Nada, soy inmune" }] },
  { "id": "dia-0084", "tema": "recuerdos", "intensidad": 1, "tipo": "opciones", "adivinar": true, "texto": "Si se borraran todas nuestras fotos menos una, ¿cuál guardarías?", "opciones": [{ "texto": "La primera juntos" }, { "texto": "Una de un viaje" }, { "texto": "Una de un día cualquiera" }, { "texto": "Una en la que salgo mal pero tú bien" }] },

  { "id": "dia-0085", "tema": "gustos", "intensidad": 1, "tipo": "opciones", "adivinar": true, "texto": "Pizza con piña:", "opciones": [{ "texto": "La defiendo", "rasgos": { "tradicion": -1 } }, { "texto": "Es un crimen", "rasgos": { "tradicion": 1 } }, { "texto": "Si toca, me la como" }, { "texto": "Nunca la he probado" }] },
  { "id": "dia-0086", "tema": "gustos", "intensidad": 1, "tipo": "opciones", "adivinar": true, "texto": "Si solo pudieras volver a comer uno:", "opciones": [{ "texto": "Bandeja paisa" }, { "texto": "Ajiaco" }, { "texto": "Sancocho" }, { "texto": "Lechona" }] },
  { "id": "dia-0087", "tema": "gustos", "intensidad": 1, "tipo": "opciones", "adivinar": true, "texto": "¿Playa o montaña?", "opciones": [{ "texto": "Playa" }, { "texto": "Montaña", "rasgos": { "ciudad": -1 } }, { "texto": "Las dos" }, { "texto": "Ninguna, prefiero la ciudad", "rasgos": { "ciudad": 2 } }] },
  { "id": "dia-0088", "tema": "gustos", "intensidad": 1, "tipo": "escala", "adivinar": true, "texto": "¿Qué tanto te gustan las películas de terror?", "extremos": ["Las odio", "Son mis favoritas"] },
  { "id": "dia-0089", "tema": "gustos", "intensidad": 1, "tipo": "opciones", "adivinar": true, "texto": "¿Qué tipo de serie es para ti?", "opciones": [{ "texto": "Crimen y suspenso" }, { "texto": "Comedia" }, { "texto": "Romance o drama" }, { "texto": "Documentales" }] },
  { "id": "dia-0090", "tema": "gustos", "intensidad": 1, "tipo": "opciones", "adivinar": true, "texto": "Para arrancar el día:", "opciones": [{ "texto": "Tinto" }, { "texto": "Aguapanela" }, { "texto": "Chocolate" }, { "texto": "Nada, no desayuno" }] },
  { "id": "dia-0091", "tema": "gustos", "intensidad": 1, "tipo": "opciones", "adivinar": true, "texto": "El regalo que más te emociona recibir:", "opciones": [{ "texto": "Algo hecho a mano" }, { "texto": "Una experiencia: viaje o concierto", "rasgos": { "aventura": 1, "ahorro": -1 } }, { "texto": "Ropa o tecnología" }, { "texto": "Comida rica" }] },
  { "id": "dia-0092", "tema": "gustos", "intensidad": 1, "tipo": "escala", "adivinar": true, "texto": "¿Cuánto picante aguantas?", "extremos": ["Ni la pimienta", "Tráeme el más bravo"], "rasgo": { "id": "aventura", "signo": 1 } },
  { "id": "dia-0093", "tema": "gustos", "intensidad": 1, "tipo": "opciones", "texto": "De una misma historia, ¿libro o película?", "opciones": [{ "texto": "El libro, siempre" }, { "texto": "La película" }, { "texto": "Me dan pereza los dos" }, { "texto": "Depende de la historia" }] },
  { "id": "dia-0094", "tema": "gustos", "intensidad": 1, "tipo": "opciones", "adivinar": true, "texto": "¿Qué deporte te verías un domingo entero?", "opciones": [{ "texto": "Fútbol" }, { "texto": "Ciclismo" }, { "texto": "Fórmula 1" }, { "texto": "Ninguno" }] },
  { "id": "dia-0095", "tema": "gustos", "intensidad": 1, "tipo": "opciones", "adivinar": true, "texto": "Tu antojo de medianoche:", "opciones": [{ "texto": "Algo dulce" }, { "texto": "Empanadas o arepa" }, { "texto": "Pizza o hamburguesa" }, { "texto": "Fruta, soy juicioso" }] },
  { "id": "dia-0096", "tema": "gustos", "intensidad": 1, "tipo": "opciones", "adivinar": true, "texto": "¿Plan sorpresa o saber todo desde antes?", "opciones": [{ "texto": "Sorpresa total", "rasgos": { "planificacion": -2 } }, { "texto": "Saber todo", "rasgos": { "planificacion": 2 } }, { "texto": "Saber la hora, no el plan" }, { "texto": "Depende del día" }] }
]

rules_version = '2';
// Reglas de Okupa. Una pareja = parejas/{codigo}; solo sus dos lugares (a y b) ven lo de adentro.
service cloud.firestore {
  match /databases/{db}/documents {
    function autenticado() { return request.auth != null; }
    function nombreValido(n) { return n is string && n.size() >= 1 && n.size() <= 30; }
    function datosPareja(codigo) { return get(/databases/$(db)/documents/parejas/$(codigo)).data; }
    function esMiembro(codigo) {
      let l = datosPareja(codigo).lugares;
      return autenticado() && (l.a == request.auth.uid || l.b == request.auth.uid);
    }
    function soloCambia(antes, despues, claves) { return despues.diff(antes).affectedKeys().hasOnly(claves); }
    function miLugar(codigo) {
      let l = datosPareja(codigo).lugares;
      return l.a == request.auth.uid ? 'a' : (l.b == request.auth.uid ? 'b' : '');
    }
    // Ocupar un lugar vacío o reclamarlo (cambio de celular): solo ese lugar y su nombre.
    function tomaLugar(x) {
      let antes = resource.data;
      let despues = request.resource.data;
      return soloCambia(antes, despues, ['lugares', 'nombres'])
        && soloCambia(antes.lugares, despues.lugares, [x])
        && soloCambia(antes.nombres, despues.nombres, [x])
        && despues.lugares[x] == request.auth.uid
        && despues.lugares.a != despues.lugares.b
        && nombreValido(despues.nombres[x]);
    }
    function cambiaSuNombre(x) {
      return resource.data.lugares[x] == request.auth.uid
        && soloCambia(resource.data, request.resource.data, ['nombres'])
        && soloCambia(resource.data.nombres, request.resource.data.nombres, [x])
        && nombreValido(request.resource.data.nombres[x]);
    }

    match /parejas/{codigo} {
      allow get: if autenticado();
      allow list: if false;
      allow create: if autenticado()
        && codigo.matches('^[A-HJKMNP-Z2-9]{6}$')
        && request.resource.data.keys().hasOnly(['lugares', 'nombres', 'creada'])
        && request.resource.data.lugares == { 'a': request.auth.uid, 'b': null }
        && request.resource.data.nombres.keys().hasOnly(['a', 'b'])
        && nombreValido(request.resource.data.nombres.a)
        && request.resource.data.nombres.b == null;
      allow update: if autenticado()
        && (tomaLugar('a') || tomaLugar('b') || cambiaSuNombre('a') || cambiaSuNombre('b'));
      allow delete: if esMiembro(codigo);

      match /perfiles/{lugar} { allow read, write: if esMiembro(codigo); }
      match /partidas/{id} { allow read, write: if esMiembro(codigo); }
      match /estado/{doc} { allow read, write: if esMiembro(codigo); }
      // Última ubicación de cada uno: los dos la ven; cada uno escribe o borra solo la suya.
      match /ubicaciones/{lugar} {
        allow read: if esMiembro(codigo);
        allow write: if esMiembro(codigo) && lugar == miLugar(codigo);
      }
      // Lugares del mapa: deseos y recuerdos. Los dos leen y escriben; cada uno solo marca su propia
      // versión como escrita.
      match /lugares/{id} {
        function lugarValido(d) {
          return d.keys().hasOnly(['nombre', 'lat', 'lng', 'tipo', 'nota', 'fecha', 'creadoPor', 'creadoMs', 'versiones'])
            && d.nombre is string && d.nombre.size() >= 1 && d.nombre.size() <= 80
            && d.lat is number && d.lat >= -90 && d.lat <= 90
            && d.lng is number && d.lng >= -180 && d.lng <= 180
            && d.tipo in ['deseo', 'recuerdo']
            && (!('nota' in d) || (d.nota is string && d.nota.size() <= 300))
            && (!('fecha' in d) || (d.fecha is string && d.fecha.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')));
        }
        function versionesPropias() {
          let antes = resource == null || !('versiones' in resource.data) ? {} : resource.data.versiones;
          let despues = !('versiones' in request.resource.data) ? {} : request.resource.data.versiones;
          return despues.diff(antes).affectedKeys().hasOnly([miLugar(codigo)]);
        }
        allow read: if esMiembro(codigo);
        allow create: if esMiembro(codigo) && lugarValido(request.resource.data) && !('versiones' in request.resource.data);
        allow update: if esMiembro(codigo) && lugarValido(request.resource.data) && versionesPropias();
        allow delete: if esMiembro(codigo);

        // La versión del otro solo se lee si ya existe la propia.
        match /versiones/{quien} {
          function esMia() { return quien == miLugar(codigo); }
          function yaEscribiLaMia() {
            return exists(/databases/$(db)/documents/parejas/$(codigo)/lugares/$(id)/versiones/$(miLugar(codigo)));
          }
          allow get: if esMiembro(codigo) && (esMia() || yaEscribiLaMia());
          allow list: if false;
          allow create, update: if esMiembro(codigo) && esMia()
            && request.resource.data.keys().hasOnly(['texto', 'horaMs'])
            && request.resource.data.texto is string
            && request.resource.data.texto.size() >= 1 && request.resource.data.texto.size() <= 1000;
          allow delete: if esMiembro(codigo) && esMia();
        }
        match /fotos/{foto} {
          allow read: if esMiembro(codigo);
          allow create: if esMiembro(codigo)
            && request.resource.data.keys().hasOnly(['datos', 'ancho', 'alto', 'por', 'creadaMs'])
            && request.resource.data.datos is string
            && request.resource.data.datos.size() <= 400000
            && request.resource.data.datos.matches('^data:image/jpeg;base64,.*');
          allow update: if false;
          allow delete: if esMiembro(codigo);
        }
      }

      // Match de deseos. El voto completo (incluido el "no") vive en match_privado, que solo lee su
      // dueño. En match_si solo hay votos positivos ({tarjeta}_{lugar}), y el del otro se lee solo
      // si ya existe el propio positivo de esa tarjeta: un "no" es indistinguible de "no ha votado".
      match /match_privado/{quien} {
        allow read, write: if esMiembro(codigo) && quien == miLugar(codigo);
      }
      match /match_si/{clave} {
        function partes() { return clave.split('_'); }
        function propio() { return partes()[1] == miLugar(codigo); }
        function tengoPositivo() {
          return exists(/databases/$(db)/documents/parejas/$(codigo)/match_si/$(partes()[0] + '_' + miLugar(codigo)));
        }
        allow get: if esMiembro(codigo) && partes().size() == 2 && (propio() || tengoPositivo());
        allow list: if false;
        allow create, update: if esMiembro(codigo) && partes().size() == 2 && propio()
          && request.resource.data.keys().hasOnly(['voto'])
          && request.resource.data.voto in ['si', 'quizas'];
        allow delete: if esMiembro(codigo) && partes().size() == 2 && propio();
      }
      match /match_matches/{tarjeta} {
        function ruta(l) { return /databases/$(db)/documents/parejas/$(codigo)/match_si/$(tarjeta + '_' + l); }
        allow read: if esMiembro(codigo);
        allow create: if esMiembro(codigo)
          && exists(ruta('a')) && exists(ruta('b'))
          && (get(ruta('a')).data.voto == 'si' || get(ruta('b')).data.voto == 'si')
          && request.resource.data.keys().hasOnly(['creadoMs', 'hecho'])
          && request.resource.data.hecho == false;
        allow update: if esMiembro(codigo)
          && soloCambia(resource.data, request.resource.data, ['hecho'])
          && request.resource.data.hecho is bool;
        allow delete: if false;
      }
      // Tarjetas creadas por la pareja: sin autor.
      match /match_tarjetas/{id} {
        allow read: if esMiembro(codigo);
        allow create: if esMiembro(codigo) && id.matches('^n-[a-z0-9]+$')
          && request.resource.data.keys().hasOnly(['mazo', 'texto', 'creadaMs'])
          && request.resource.data.mazo in ['citas', 'viajes', 'finde', 'aprender', 'retos', 'intimidad']
          && request.resource.data.texto is string
          && request.resource.data.texto.size() >= 5 && request.resource.data.texto.size() <= 140;
        allow update, delete: if false;
      }
      match /dias/{fecha} {
        allow read, write: if esMiembro(codigo);

        // Respuestas del diario: {gustos|ingles}_{a|b}. Cada uno crea la suya una sola vez, y solo ve
        // la del otro en una parte si ya envió la propia de esa misma parte.
        match /respuestas/{parte} {
          function valida() { return parte.matches('^(gustos|ingles)_(a|b)$'); }
          function deParte() { return parte.split('_')[0]; }
          function esMia() { return parte.split('_')[1] == miLugar(codigo); }
          function yaEnvieLaMia() {
            return exists(/databases/$(db)/documents/parejas/$(codigo)/dias/$(fecha)/respuestas/$(deParte() + '_' + miLugar(codigo)));
          }
          allow get: if esMiembro(codigo) && valida() && (esMia() || yaEnvieLaMia());
          allow list: if false;
          allow create: if esMiembro(codigo) && valida() && esMia();
          allow update: if false;
          allow delete: if esMiembro(codigo);
        }
      }
    }
  }
}
